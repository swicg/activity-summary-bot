SMTP_HOST=
# usually 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS (port 587); set to false only for a plain local test server
SMTP_TLS=true
# Implicit TLS instead of STARTTLS, for port 465 only
# SMTP_SSL=true

# true: log digests instead of sending them, plus debug logging (true/false only)
# DEBUG=true

GH_OAUTH_TOKEN=
